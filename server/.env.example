# ⚙️ CONFIGURACIÓN DEL SERVIDOR - Ferretería JRC

# Puerto donde corre el servidor
PORT=5000

# Supabase (la clave service_role solo va en el servidor; nunca en el frontend)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# SQLite se conserva para la configuración local de permisos por rol
DATABASE_PATH=./data/ferreterianew.db

# JWT - Genera un valor aleatorio de al menos 32 caracteres y colócalo en server/.env
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMTP - Configuración para envío de emails
# Para desarrollo, usa MailHog (http://localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=noreply@ferreteriajrc.com
SMTP_PASSWORD=password

# Email de remitente
EMAIL_FROM=noreply@ferreteriajrc.com

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Nota: Después de instalar, duplica este archivo a .env
# En producción, cambiar todos los valores

