# ⚙️ CONFIGURACIÓN DEL SERVIDOR - Ferretería JRC

# Puerto donde corre el servidor
PORT=5000

# Ruta de la base de datos SQLite
DATABASE_PATH=./data/ferreterianew.db

# JWT - Cambiar a valor aleatorio fuerte en PRODUCCIÓN
JWT_SECRET=tu_secret_super_seguro_cambiar_en_produccion_2024!@#$%
JWT_EXPIRES_IN=7d

# SMTP - Configuración para envío de emails
# Para desarrollo, usa MailHog (http://localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=noreply@ferreteriajrc.com
SMTP_PASSWORD=password

# Email de remitente
EMAIL_FROM=noreply@ferreteriajrc.com

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Nota: Después de instalar, duplica este archivo a .env
# En producción, cambiar todos los valores

